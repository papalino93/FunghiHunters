# Copia in .env.local (già ignorato da git) e compila con i valori del tuo progetto Supabase.
# Senza queste variabili l'app funziona lo stesso: login e sincronizzazione restano disattivati
# in modo esplicito, vedi docs/SYNC.md.

# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stessa pagina, "service_role" — SEGRETA. Solo lato server (route API), mai nel browser,
# mai con prefisso NEXT_PUBLIC_. Serve solo per la cancellazione account.
SUPABASE_SERVICE_ROLE_KEY=

# Facoltativa: dominio pubblico dell'app, usato per i link delle anteprime social (og:image).
# Su Vercel non serve, il dominio di produzione viene letto da solo. L'accesso con Google NON la
# usa: torna sempre sull'origine da cui si è partiti. Vedi docs/DEPLOY-VERCEL.md.
# NEXT_PUBLIC_SITE_URL=https://la-tua-app.vercel.app
